# Cloud Cuttlefish Orchestrator, local development environment.
#
# The orchestrator reads its configuration entirely from CCO_* environment
# variables (there is no config file). In production Terraform sets these on the
# Cloud Run service; for local development, copy this file to .env, fill in your
# values, and load it into your shell before running:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   go run ./cmd/orchestrator
#
# (or use direnv). Only deployment values live here. Operational tuning
# (server timeouts, reaper/worker/sync intervals) uses the code defaults in
# internal/config; override one with its CCO_* var only if you must. Secrets are
# read from mounted files in production (CCO_*_FILE); locally, set the plain
# CCO_* value shown below.

# --- Topology + auth (required) ---
CCO_DEVICE_INGRESS=public          # public | private | relay
CCO_AUTH_MODE=iap

# Local dev usually trusts a forgeable identity header instead of real IAP.
# dev_mode is refused in any GCP environment. With dev_mode on, the audience
# below is not needed.
CCO_DEV_MODE=true
CCO_DEV_FALLBACK_EMAIL=you@example.com
# CCO_IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/REGION/services/SERVICE

# --- Spanner (required) ---
CCO_SPANNER_PROJECT=your-project
CCO_SPANNER_INSTANCE=cuttlefish-orchestrator
CCO_SPANNER_DATABASE=orchestrator
# Point at the local emulator instead of real Spanner:
# SPANNER_EMULATOR_HOST=localhost:9010

# --- GCP (required: project_id, host image project and deployment; the rest have sane behavior when unset) ---
CCO_PROJECT_ID=your-project
CCO_HOST_IMAGE_PROJECT=your-project   # where the cco-host image families live
CCO_DEPLOYMENT=cco                    # labels this install's host VMs; unique per project
CCO_NETWORK=projects/your-project/global/networks/cuttlefish-network
CCO_SUBNETWORK=projects/your-project/regions/your-region/subnetworks/cuttlefish-network-subnet
# CCO_HOST_SERVICE_ACCOUNT=host-sa@your-project.iam.gserviceaccount.com
# CCO_HOST_ORCHESTRATOR_PORT=2080
# CCO_ALLOW_SELF_SIGNED_HOST_SSL_CERT=true

# --- GCE Spot capacity advice ---
# CCO_SPOT_ADVICE=true             # probe the beta advice.capacity API; default off

# --- TURN (only when CCO_DEVICE_INGRESS=relay) ---
# CCO_TURN_SERVERS=turn:IP:3478,turns:IP:5349    # client leg, comma-separated
# CCO_DEVICE_TURN_SERVERS=turn:10.0.0.7:3478     # device leg, internal addresses
# CCO_TURN_SHARED_SECRET=...                     # or CCO_TURN_SHARED_SECRET_FILE=/path

# --- STUN (every mode; defaults to Google's public pair) ---
# CCO_STUN_SERVERS=stun:stun.example:19302       # replaces the default pair
