# Exclude frontend assets, dependencies, git history, Docker metadata, and test artifacts
# from the Go backend API container build context.

.git
.gitignore
.github
.DS_Store

Dockerfile
Dockerfile*
!Dockerfile.workflow
.dockerignore
cloudbuild.yaml
.gcloudignore
.env*

web/
node_modules/
dist/
.angular/
coverage/
e2e/

docs/
deployment/
examples/
migrations/
scripts/
terraform/
tests/
tools/

*.md
*.log
*.out
*.test
tmp/
orchestrator
cfctl
relayhook
