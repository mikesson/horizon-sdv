{
  "name": "cuttlefish-console",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node -e \"const {spawnSync}=require('node:child_process');const major=Number(process.versions.node.split('.')[0]);const env={...process.env};if(major>=25){env.NODE_OPTIONS=[env.NODE_OPTIONS,'--no-webstorage'].filter(Boolean).join(' ');}const r=spawnSync('npx',['--no-install','ng','test',...process.argv.slice(1)],{stdio:'inherit',env});process.exit(r.status??1);\" --",
    "check:schema-drift": "npx tsx scripts/gates/check-schema-drift.ts",
    "check:fixture-shapes": "npx tsx scripts/gates/check-fixture-shapes.ts",
    "check:launch-templates": "npx tsx scripts/gates/check-launch-templates.ts",
    "lint": "npm run lint:biome; b=$?; npm run lint:eslint; e=$?; npm run lint:css; c=$?; npm run typecheck:e2e; t=$?; npm run check:fixture-shapes; f=$?; npm run check:launch-templates; l=$?; exit $((b|e|c|t|f|l))",
    "lint:biome": "biome check --error-on-warnings src/ scripts/ e2e/",
    "lint:eslint": "eslint --max-warnings=0 src/ scripts/ e2e/",
    "fix": "npm run fix:biome; b=$?; npm run fix:eslint; e=$?; exit $((b|e))",
    "fix:biome": "biome check --write src/ scripts/ e2e/",
    "fix:eslint": "eslint --fix src/ scripts/ e2e/",
    "format": "biome format --write src/ scripts/ e2e/",
    "audit": "node scripts/gates/dead-css.mjs --report; knip",
    "audit:deps": "npm audit --omit=dev",
    "audit:knip": "knip",
    "audit:knip:production": "knip --production --include exports,types,files",
    "audit:dead-css": "node scripts/gates/dead-css.mjs",
    "audit:css-usage": "CCO_CSS_USAGE=1 playwright test && node scripts/audit/css-usage-report.mjs",
    "analyze": "ng build --configuration production --stats-json && echo '\\nBundle metafile: dist/cuttlefish-console/stats.json, analyze at https://esbuild.github.io/analyze/'",
    "coverage:ui": "node scripts/audit/coverage.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint:css": "node scripts/gates/css-gate-selftest.mjs && stylelint --max-warnings 0 \"src/**/*.scss\" \"src/**/*.ts\"",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "@ngrx/signals": {
      "@angular/core": "$@angular/core"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "@lezer/highlight": "^1.2.3",
    "@ngrx/operators": "^21.0.0",
    "@ngrx/signals": "^21.0.0",
    "@types/node": "^24.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/android-bin": "^2.1.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "codemirror-json-schema": "^0.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.7.0",
    "jsdom": "^27.2.0",
    "knip": "^6.27.0",
    "playwright": "^1.60.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.14"
  }
}
