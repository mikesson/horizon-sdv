{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/src/**/*.ts",
      "**/scripts/**/*.ts",
      "**/e2e/**/*.ts",
      "**/src/**/*.js",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.angular"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noBannedTypes": "error",
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noForEach": "off",
        "noUselessConstructor": "error",
        "useSimplifiedLogicExpression": "warn",
        "noUselessTypeConstraint": "error",
        "noUselessFragments": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUndeclaredVariables": "error",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noBarrelFile": "off",
        "noReExportAll": "off",
        "noDelete": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noParameterAssign": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useForOf": "error",
        "useFragmentSyntax": "off",
        "useImportType": "off",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "function"
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "typeLike"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "enum"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "enumMember"
                },
                "formats": ["PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "classProperty",
                  "modifiers": ["readonly"]
                },
                "match": "(.+?)\\$?",
                "formats": ["camelCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "classProperty",
                  "modifiers": ["private"]
                },
                "formats": ["camelCase"],
                "match": "(.+?)\\$?"
              },
              {
                "selector": {
                  "kind": "classProperty",
                  "modifiers": ["static", "readonly"]
                },
                "formats": ["camelCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "snake_case"]
              }
            ]
          }
        },
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useArrayLiterals": "error",
        "useConsistentArrayType": "off",
        "useDefaultSwitchClause": "warn",
        "noCommonJs": "error",
        "noRestrictedImports": "off",
        "noDefaultExport": "error",
        "useExplicitLengthCheck": "error",
        "noInferrableTypes": "off",
        "noNamespace": "error",
        "useShorthandFunctionType": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn", "info"]
          }
        },
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noEmptyBlockStatements": "warn",
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noRedeclare": "error",
        "noShadowRestrictedNames": "error",
        "useAwait": "warn",
        "noVar": "error",
        "noConfusingVoidType": "error",
        "noAsyncPromiseExecutor": "error",
        "noMisleadingCharacterClass": "error",
        "noUnsafeDeclarationMerging": "error",
        "useIsArray": "error"
      },
      "nursery": {
        "noFloatingPromises": "warn"
      },
      "a11y": {
        "noAccessKey": "warn",
        "noAriaUnsupportedElements": "error",
        "noPositiveTabindex": "error",
        "useAltText": "error",
        "useValidAriaValues": "error",
        "useKeyWithClickEvents": "warn",
        "useButtonType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "bracketSameLine": true
    },
    "globals": ["describe", "it", "expect", "beforeEach", "afterEach", "vi", "$localize"]
  }
}
