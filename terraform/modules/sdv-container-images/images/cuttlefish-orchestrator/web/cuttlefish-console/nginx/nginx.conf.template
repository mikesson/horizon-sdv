worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Non-root readOnlyRootFilesystem writable temp locations
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Preserves HTTP/1.1 keepalive ('') for REST while passing 'upgrade' for WebSockets
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    upstream api_upstream {
        server __API_UPSTREAM__;
        keepalive 32;
    }

    server {
        listen __PORT__;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        absolute_redirect off;
        port_in_redirect off;

        include /etc/nginx/snippets/security-headers.conf;

        # 1. Fail closed on main port: kubelet probes target __PROBE_PORT__ so
        # unauthenticated /healthz never shares :8080 with proxy/SPA traffic
        # or falls through to location / index.html.
        location = /healthz {
            access_log off;
            include /etc/nginx/snippets/security-headers.conf;
            return 404;
        }

        # 2. Canonical trailing slash on /cuttlefish-orchestrator (evaluated before server rewrite match)
        location = /cuttlefish-orchestrator {
            return 301 /cuttlefish-orchestrator/$is_args$args;
        }

        # 3. Strip public subpath prefix so downstream rules work identically whether
        #    traffic keeps /cuttlefish-orchestrator/ (oauth2-proxy) or arrives stripped.
        rewrite ^/cuttlefish-orchestrator(/.*)$ $1 last;

        # 4. Direct /oauth2/* requests without an upstream auth proxy fail closed instead of SPA fallback.
        location ^~ /oauth2/ {
            include /etc/nginx/snippets/security-headers.conf;
            return 404;
        }

        # 4. Exact SPA entry document (never cached; always revalidated)
        location = /index.html {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
            try_files $uri =404;
        }

        # 5. Exact OpenAPI / Scalar Docs / Health / Defensive Auth routes -> Go API
        location = /docs {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /docs/ {
            return 301 /cuttlefish-orchestrator/docs;
        }

        location = /openapi.json {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /openapi.yaml {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /health {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /ready {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /info {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /auth {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /oauth2callback {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location = /deauth {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        # 6. Prefix (^~) API & Static Directories (guaranteed non-WebSocket; blocks regex override)
        location ^~ /schemas/ {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location ^~ /api/v1/ {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_pass http://api_upstream;
        }

        location ^~ /v2/storage/ {
            include /etc/nginx/snippets/proxy-common.conf;
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_pass http://api_upstream;
        }

        location ^~ /media/ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        location ^~ /assets/ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=3600" always;
            try_files $uri =404;
        }

        # 7. Dedicated WebSocket Regex Locations (evaluated BEFORE plain prefix /v2/, /connect/, /v1/)
        location ~ ^/v2/devices/[^/]+/instances/[^/]+/(?:signaling/ws|adb)$ {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_pass http://api_upstream;
        }

        location ~ ^/connect/.+/ws$ {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_pass http://api_upstream;
        }

        location ~ ^/v1/zones/[^/]+/hosts/[^/]+/connect_client$ {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_pass http://api_upstream;
        }

        # 8. Root-only Static Bundle & Favicon Regexes (single segment [^/]+ cannot touch /v2/, /v1/, /connect/)
        location ~* "^/[^/]+-[A-Za-z0-9_-]{8,}\.(?:js|mjs|css)(?:\.map)?$" {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        location ~* ^/[^/]+\.(?:js|mjs|css|woff2?|ttf|svg|png|jpe?g|webp|ico|txt|map)$ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=3600" always;
            try_files $uri =404;
        }

        # 9. Plain Prefix API Routes (NO ^~ so section 7 WS regexes win over /v2/, /connect/, /v1/)
        location /v2/ {
            include /etc/nginx/snippets/proxy-common.conf;
            client_max_body_size 64m;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_pass http://api_upstream;
        }

        location /v1/ {
            include /etc/nginx/snippets/proxy-common.conf;
            client_max_body_size 64m;
            # Must exceed co_proxy.go hoProxyResponseHeaderTimeout (3m) for :wait long-polls
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_pass http://api_upstream;
        }

        location /connect/ {
            include /etc/nginx/snippets/proxy-common.conf;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_pass http://api_upstream;
        }

        # 10. Catch-all Angular SPA Fallback (no $uri/ so routes matching folder names still load index.html)
        location / {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
            try_files $uri /index.html;
        }
    }

    # Dedicated unauthenticated probe server for kubelet readiness/liveness checks.
    server {
        listen __PROBE_PORT__;
        server_name _;

        location = /healthz {
            access_log off;
            include /etc/nginx/snippets/security-headers.conf;
            add_header Content-Type "text/plain; charset=utf-8" always;
            add_header Cache-Control "no-store" always;
            return 200 "ok\n";
        }

        location / {
            include /etc/nginx/snippets/security-headers.conf;
            return 404;
        }
    }
}
