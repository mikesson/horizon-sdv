module cloud-cuttlefish-orchestrator

go 1.26.9

// Keep the go tool from walking non-Go trees during package matching:
// web/ holds node_modules (tens of thousands of directories) and UPSTREAM/
// holds git-excluded external clones.
ignore (
	./UPSTREAM
	./web
)

require (
	cloud.google.com/go/compute v1.64.0
	cloud.google.com/go/monitoring v1.29.0
	cloud.google.com/go/spanner v1.92.0
