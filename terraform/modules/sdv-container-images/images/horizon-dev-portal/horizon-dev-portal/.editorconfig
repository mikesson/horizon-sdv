# Shared editor settings for VS Code, IntelliJ IDEA, and other EditorConfig-aware tools.
# IntelliJ: enable Settings → Languages & Frameworks → JavaScript → Prettier → "Run on save"
# with Prettier package set to ./node_modules/prettier.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
