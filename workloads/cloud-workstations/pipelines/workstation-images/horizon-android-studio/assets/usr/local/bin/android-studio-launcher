set -euo pipefail

# Monitor-aware, XWayland-safe launcher for Android Studio. Invoked by
# jetbrains-studio.desktop (both dock/menu launches and the autostart entry
# created by desktop_apply_integration via WORKSTATION_DEFAULT_APP).

# shellcheck source=/dev/null
source /google/scripts/common.sh
# shellcheck source=/dev/null
source /google/scripts/desktop_utils.sh

# The GNOME session defaults to native Wayland (GDK_BACKEND=wayland), but the
# JetBrains platform's AWT/Swing stack is far more stable on X11/XWayland.
# Force the XWayland path rather than inheriting the session default.
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
# Force AWT to use XToolkit (X11) instead of auto-detecting Wayland, and pick
# up JAVA_TOOL_OPTIONS in the Studio launcher's JVM regardless of how it
# constructs its own vmoptions.
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:-} -Dawt.toolkit.name=XToolkit"

# Mirror the GNOME base's software-rendering fallback when no GPU is present,
# rather than inventing separate, unverified IDE-specific rendering flags.
if [[ "${WORKSTATION_GPU_ENABLED:-false}" == "false" ]]; then
  log "No GPU detected. Forcing software rendering (LLVMpipe) for Android Studio."
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  export MESA_LOADER_DRIVER_OVERRIDE=swrast
fi

# Avoid launching Java/AWT before GNOME Shell reports an active monitor;
# doing so can produce "no screen devices" startup failures.
log "Waiting for an active monitor before launching Android Studio..."
wait_for_monitor 60

exec /opt/google/android-studio/bin/studio.sh "$@"
